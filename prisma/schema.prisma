generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id
  name         String
  lastname     String
  email        String   @unique
  phone        String
  createdAt    DateTime
  passwordHash String
}

model Project {
  id           String @id
  nombre       String
  descripcion  String
  constructora String
  ubicacion    String

  estado String

  plazoEntrega           String
  valorSeparacion        Decimal
  porcentajeFinanciacion Decimal
  rentabilidadAnual      Decimal?
  rentaCorta             Boolean
  tipoInmueble           String?
  precioMinimo           Decimal?
  media                  ProjectMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMedia {
  id        String @id
  projectId String

  url      String
  type     String
  position Int?

  project Project @relation(fields: [projectId], references: [id])
}
